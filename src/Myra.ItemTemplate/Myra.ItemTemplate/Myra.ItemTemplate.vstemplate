<VSTemplate Version="3.0.0"
            Type="Item"
            xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">

  <TemplateData>
    <Name>Myra UserControl</Name>
    <Description>Creates a Myra UserControl with code-behind.</Description>
    <Icon>Myra.ItemTemplate.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <DefaultName>UserControl.xaml</DefaultName>
  </TemplateData>

  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.xaml">UserControl.xaml</ProjectItem>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.xaml.cs">UserControl.xaml.cs</ProjectItem>
  </TemplateContent>
</VSTemplate>