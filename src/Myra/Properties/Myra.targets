<Project>

  <ItemGroup>
    <AdditionalFiles Include="@(MyraXaml)" />
    <Analyzer Include="$(MSBuildThisFileDirectory)Myra.Analyzer\Myra.Analyzer.dll"  />
  </ItemGroup>
  
  <UsingTask
      TaskName="Myra.Xaml.MyraXamlCompileTask"
      AssemblyFile="$(MSBuildThisFileDirectory)Myra.Xaml\Myra.Xaml.dll" />

  <Target
      Name="MyraXamlCompile"
      AfterTargets="CoreCompile"
      Condition="'$(DesignTimeBuild)' != 'true' and '@(MyraXaml)' != ''">

    <MyraXamlCompileTask
        TargetPath="$(TargetPath)"
        MyraFiles="@(MyraXaml)"
        ReferenceAssemblies="@(ReferencePath)"
        Debug="$(DebugSymbols)" /> 
  </Target> 
</Project>