<VerticalStackPanel Spacing="8" Height="300" xmlns="https://github.com/MyraUI/Myra"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <HorizontalMenu>
    <MenuItem Text="&amp;Units">
      <MenuItem Text="Add &amp;Orc" />
      <MenuItem Text="Add &amp;Peasant" />
      <MenuItem Text="Add &amp;Knight" />
      <MenuItem Text="Add &amp;Priest" />
      <MenuItem Text="Add &amp;Wizard" />
    </MenuItem>
    <MenuItem Text="&amp;Operations">
      <MenuItem Text="Add 10000 &amp;Gold" />
      <MenuItem Text="Add 10000 &amp;Wood" />
    </MenuItem>
  </HorizontalMenu>
  <HorizontalStackPanel Spacing="8">
    <Label Text="Command:" />
    <TextBox />
  </HorizontalStackPanel>
  <Button HorizontalAlignment="Center" Click="{Binding _buttonHideDebug_Click}">
    <Label Text="Hide Debug Panel" />
  </Button>
</VerticalStackPanel>