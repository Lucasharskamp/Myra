<AllWidgets xmlns="https://github.com/MyraUI/Myra"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <VerticalStackPanel Spacing="8">
        <HorizontalMenu VerticalAlignment="Stretch" x:Name="_mainMenu">
            <MenuItem Text="&amp;File">
                <MenuItem Text="&amp;Open" ShortcutText="Ctrl+O" Selected="OpenFile" Image="icon-folder" />
                <MenuItem Text="&amp;Save" ShortcutText="Ctrl+S" Selected="SaveFile" Image="icon-folder-new" />
                <MenuItem Text="Choose Fol&amp;der" ShortcutText="Ctrl+D" Selected="ChooseFolder"   />
                <MenuItem Text="Choose Co&amp;lor" ShortcutText="Ctrl+L" Selected="ChooseColor" />
                <MenuSeparator />
                <MenuItem Text="&amp;Quit" ShortcutText="Ctrl+Q" Selected="Quit" />
            </MenuItem>
            <MenuItem Text="&amp;Edit">
                <MenuItem Text="&amp;Copy" ShortcutText="Ctrl+Insert, Ctrl+C"  />
                <MenuItem Text="&amp;Paste" ShortcutText="Shift+Insert, Ctrl+V" />
                <MenuSeparator />
                <MenuItem Text="&amp;Undo" ShortcutText="Ctrl+Z" />
                <MenuItem Text="&amp;Redo" ShortcutText="Ctrl+Y" />
            </MenuItem>
            <MenuItem Text="&amp;Help">
                <MenuItem Text="&amp;About" Selected="ShowMessageBox" />
            </MenuItem>
        </HorizontalMenu>
        <HorizontalSplitPane StackPanel.ProportionType="Fill">
            <ScrollViewer ShowHorizontalScrollBar="False">
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.DefaultRowProportion>Auto</Grid.DefaultRowProportion>
                    <Grid.ColumnsProportions>
                        <Proportion>Auto</Proportion>
                        <Proportion>Auto</Proportion>
                        <Proportion>Fill</Proportion>
                    </Grid.ColumnsProportions>
                    <Label Text="Button:" />
                    <Button Padding="8, 0" Tooltip="E=mc/v[-8]2/n/vdMass–energy equivalence." Click="SaveFile"  Grid.Column="1">
                        <HorizontalStackPanel>
                            <Image Renderable="icon-star" />
                            <Label Text="Save File" />
                        </HorizontalStackPanel>
                    </Button>
                    <TextBox x:Name="_textSaveFile" Grid.Column="2" />
                    <Label Text="Another Button:" Grid.Row="1" />
                    <Button Padding="8, 0" Tooltip="Tooltip 2" Click="OpenFile" Grid.Column="1" Grid.Row="1">
                        <HorizontalStackPanel>
                            <Image Renderable="icon-star"  />
                            <Label Text="Open File" />
                        </HorizontalStackPanel>
                    </Button>
                    <TextBox x:Name="_textOpenFile" Grid.Column="2" Grid.Row="1" />
                    <Label Text="Blue Button:" Grid.Row="2" />
                    <Button StyleName="blue" Padding="8, 0" Click="ChooseFolder" Grid.Column="1" Grid.Row="2">
                        <HorizontalStackPanel>
                            <Image Renderable="icon-star" />
                            <Label Text="Choose Folder" />
                        </HorizontalStackPanel>
                    </Button>
                    <TextBox x:Name="_textChooseFolder" Grid.Column="2" Grid.Row="2" />
                    <Label Text="Text Button:" x:Name="_textButtonLabel" Grid.Row="3" />
                    <Button Padding="8, 0" Click="ChooseColor"  Grid.Column="1" Grid.Row="3">
                        <Label Text="Choose Color" />
                    </Button>
                    <Label Text="Image Button:" Grid.Row="4" />
                    <Button Padding="8, 0" Click="ShowDebugOptionsModal" Grid.Column="1" Grid.Row="4">
                        <Image Renderable="icon-star-outline" />
                    </Button>
                    <CheckButton CheckContentSpacing="4" Grid.Row="5" Grid.ColumnSpan="2">
                        <Label Text="This is checkbox" />
                    </CheckButton>
                    <Label Text="Horizontal Slider:" Grid.Row="6" />
                    <HorizontalSlider Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="2" />
                    <Label Text="Combo View:" Grid.Row="7" />
                    <ComboView Width="200" Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="2">
                        <Label Text="Red" TextColor="#FF0000FF" />
                        <Label Text="Green" TextColor="#00FF00FF" />
                        <Label Text="Blue" TextColor="#0000FFFF" />
                    </ComboView>
                    <Label Text="Text Field:" Grid.Row="8" />
                    <TextBox Grid.Column="1" Grid.Row="8" Grid.ColumnSpan="2" />
                    <Label Text="Spin Button:" Grid.Row="9" />
                    <SpinButton Value="1" Width="100" Grid.Column="1" Grid.Row="9" />
                    <Label Text="List View:" Grid.Row="10" />
                    <ListView Width="200" Grid.Column="1" Grid.Row="10" Grid.ColumnSpan="2">
                        <Label Text="Red" TextColor="#FF0000FF" />
                        <Label Text="Green" TextColor="#00FF00FF" />
                        <Label Text="Blue" TextColor="#0000FFFF" />
                    </ListView>
                    <Label Text="Vertical Menu:" Grid.Row="11" />
                    <VerticalMenu Grid.Column="1" Grid.Row="11">
                        <MenuItem Text="Start New Game" />
                        <MenuItem Text="Options" />
                        <MenuItem Text="Quit" />
                    </VerticalMenu>
                    <Label Text="Tree" Grid.Row="12" />
                    <TreeView x:Name="_treeView">
                        
                    </TreeView>
                </Grid>
            </ScrollViewer>
            <VerticalSplitPane>
                <Grid RowSpacing="8">
                    <Grid.ColumnsProportions>
                        <Proportion>Fill</Proportion>
                    </Grid.ColumnsProportions>
                    <Grid.RowsProportions>
                        <Proportion>Auto</Proportion>
                        <Proportion>Fill</Proportion>
                    </Grid.RowsProportions>
                    <Label Text="Vertical Slider:" />
                    <VerticalSlider HorizontalAlignment="Center" Grid.Row="1" />
                </Grid>
                <Grid RowSpacing="8">
                    <Grid.ColumnsProportions>
                        <Proportion>Fill</Proportion>
                    </Grid.ColumnsProportions>
                    <Grid.RowsProportions>
                        <Proportion>Auto</Proportion>
                        <Proportion>Auto</Proportion>
                        <Proportion>Fill</Proportion>
                    </Grid.RowsProportions>
                    <Label Text="Progress Bars:" />
                    <HorizontalProgressBar x:Name="_horizontalProgressBar" Grid.Row="1" />
                    <VerticalProgressBar HorizontalAlignment="Center" x:Name="_verticalProgressBar" Grid.Row="2" />
                </Grid>
            </VerticalSplitPane>
        </HorizontalSplitPane>
    </VerticalStackPanel>
    <Label Text="Is mouse over GUI: true" VerticalAlignment="Bottom" x:Name="_labelOverGui" />
</AllWidgets> 